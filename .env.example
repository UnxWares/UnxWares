# GitHub Token (optional - only for private repos or higher rate limits)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxx

# LibreTranslate API (optional - for auto-translation)
# Without this key, blog posts will only be displayed in French (original language)
# LIBRETRANSLATE_API_KEY=your-key-here
#
# Matrix Server Url (needed for Matrix well-known endpoints)
# MATRIX_SERVER_URL=https://matrix.unxwares.com
